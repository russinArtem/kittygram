server {
    server_name 158.160.227.112 myhostartrus.servehttp.com;

    location /api/ {
        proxy_pass http://127.0.0.1:8001;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:8001;
    }

    location / {
        root   /var/www/taski;
        index  index.html index.htm;
        try_files $uri /index.html;
    }


    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/myhostartrus.servehttp.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/myhostartrus.servehttp.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = myhostartrus.servehttp.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot



    listen 80;
    server_name 158.160.227.112 myhostartrus.servehttp.com;
    return 404; # managed by Certbot


}
server {
    server_name 158.160.227.112 kittygramartrus.servehttp.com;

